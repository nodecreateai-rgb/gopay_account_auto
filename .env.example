# 复制为 .env 后填写（勿提交 .env）
# 也可直接 export 到当前 shell

# ── 必填（敏感项建议只放环境变量）────────────────────────
HERO_SMS_API_KEY=your-hero-sms-api-key
GOPAY_PROXY=http://127.0.0.1:10808

# ── 注册（signup）────────────────────────────────────────
GOPAY_SIGNUP_PIN=123456
GOPAY_SIGNUP_COUNTRY_CODE=+62

# ── 可选：Hero-SMS ───────────────────────────────────────
# HERO_SMS_HANDLER_URL=https://hero-sms.com/stubs/handler_api.php
# HERO_SMS_SERVICE=ni
# HERO_SMS_COUNTRY=6
# HERO_SMS_POLL_TIMEOUT_SEC=300
# HERO_SMS_ENABLED=true

# API 监听端口（默认 28000）
# GOPAY_API_PORT=28000

# 取号+注册失败时换号重试次数（默认 3，含已注册/限流等）
# GOPAY_REGISTER_RETRY=3

# 兼容别名（与 gpt_plus 一致时可混用）
# PROXY=http://127.0.0.1:10808
# GOPAY_DEFAULT_PIN=123456
# GOPAY_COUNTRY_CODE=+62
