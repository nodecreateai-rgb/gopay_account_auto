# 复制为 .env 后填写（勿提交 .env）

# ── 必填 ─────────────────────────────────────────────────
GRIZZLY_SMS_API_KEY=your-grizzly-sms-api-key
GOPAY_PROXY=http://127.0.0.1:10808

# ── 注册（signup）────────────────────────────────────────
GOPAY_SIGNUP_PIN=123456
GOPAY_SIGNUP_COUNTRY_CODE=+62

# ── GrizzlySMS（GoPay 印尼）──────────────────────────────
# GRIZZLY_SMS_HANDLER_URL=https://api.grizzlysms.com/stubs/handler_api.php
# GRIZZLY_SMS_SERVICE=ni
# GRIZZLY_SMS_COUNTRY=6
# GRIZZLY_SMS_MAX_PRICE=0.045
# GRIZZLY_SMS_POLL_TIMEOUT_SEC=300
# GRIZZLY_SMS_ENABLED=true

# 取号+注册失败时换号重试（默认 3）
# GOPAY_REGISTER_RETRY=3

# API 端口（默认 28000）
# GOPAY_API_PORT=28000

# 兼容 gpt_plus 别名
# CPA_GRIZZLY_SMS_API_KEY=
# PROXY=http://127.0.0.1:10808
